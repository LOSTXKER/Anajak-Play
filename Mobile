const Badge = ({ text, color = "purple" }) => {
  const colorClass = color === "blue" 
    ? "bg-blue-500/20 text-blue-400 border-blue-500/30" 
    : "bg-purple-500/20 text-purple-400 border-purple-500/30";
  
  return (
    <span className={`text-[10px] px-2 py-0.5 rounded-full border ${colorClass} font-medium`}>
      {text}
    </span>
  );
};

const LiveTicker = () => {
  const [index, setIndex] = useState(0);

  useEffect(() => {
    const interval = setInterval(() => {
      setIndex((prev) => (prev + 1) % LIVE_FEED.length);
    }, 3000);
    return () => clearInterval(interval);
  }, []);

  return (
    <div className="bg-[#111118] border-b border-white/5 py-2 px-4 flex items-center gap-2 overflow-hidden">
      <div className="w-2 h-2 rounded-full bg-green-500 animate-pulse flex-shrink-0" />
      <span className="text-xs text-gray-400 whitespace-nowrap">Live: </span>
      <p className="text-xs text-gray-200 animate-fade-in truncate w-full">
        {LIVE_FEED[index]}
      </p>
    </div>
  );
};

